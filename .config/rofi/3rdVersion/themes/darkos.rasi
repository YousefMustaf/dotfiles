* {
    bg:              #1e1e2e;
    bg-alt:          #313244;
    fg:              #cdd6f4;
    fg-alt:          #7f849c;
    accent:          #89b4fa;
    urgent:          #f38ba8;
    border:          #45475a;

    background-color: @bg;
    text-color: @fg;

    border: 1px;
    border-color: @border;

    margin: 0px;
    padding: 0px;
    spacing: 8px;
}

window {
    width: 720px;
    border-radius: 0px;
    location: center;
    anchor: center;
    transparency: "real";
}

mainbox {
    children: [inputbar, listview];
    spacing: 15px;
    padding: 20px;
}

inputbar {
    background-color: @bg-alt;
    border-radius: 12px;
    padding: 12px;
    children: [prompt, entry];
}

prompt {
    text-color: @accent;
}

entry {
    placeholder: "Search...";
    placeholder-color: @fg-alt;
}

listview {
    lines: 10;
    columns: 1;
    fixed-height: false;
    scrollbar: false;
    spacing: 6px;
}

element {
    orientation: horizontal;
    spacing: 12px;
    padding: 10px;
    border: 0px;
    border-radius: 8px;
    background-color: transparent;
}

element selected {
    background-color: #313244;
    text-color: #cdd6f4;
    border: 0px;
}

element-text {
    vertical-align: 0.5;
}

element-icon {
    size: 22px;
    background-color: transparent;
}

element normal.normal {
    background-color: transparent;
    text-color: #cdd6f4;
}

element selected.normal {
    background-color: #313244;
    text-color: #cdd6f4;
}
