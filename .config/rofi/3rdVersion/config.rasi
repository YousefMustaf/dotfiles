configuration {
    modi: "drun,run,window";
    show-icons: true;
    icon-theme: "Papirus-Dark";
    terminal: "kitty";
    drun-display-format: "{icon}  {name}";
    display-drun: "Applications";
    display-run: "Run";
    display-window: "Windows";
}

@theme "~/.config/rofi/themes/darkos.rasi"
